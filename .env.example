# Load these into your application service's environment. Django does not
# automatically load .env files. Never commit .env or live credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=django-insecure-replace-with-a-private-random-value-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=bouvane.com,www.bouvane.com
CSRF_TRUSTED_ORIGINS=https://bouvane.com,https://www.bouvane.com

# Spaceship / Spacemail: mailbox credentials, not your Spaceship account login.
EMAIL_HOST=mail.spacemail.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=support@bouvane.com
EMAIL_HOST_PASSWORD=replace-with-your-mailbox-password
DEFAULT_FROM_EMAIL='Bouvane <support@bouvane.com>'
SUPPORT_EMAIL=support@bouvane.com
PUBLIC_SITE_URL=https://bouvane.com
CONTACT_RECIPIENT=support@bouvane.com

# Optional dedicated Fernet key. If blank, encryption derives from
# DJANGO_SECRET_KEY. Keep whichever key is used stable and backed up.
MFA_ENCRYPTION_KEY=
